rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isChatParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Anyone signed in can read user profiles (for search)
      allow read: if isSignedIn();
      // Only the user can write their own document
      allow write: if isSignedIn() && isOwner(uid);
    }

    // ── Chats ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      // Read: only participants
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      // Create: you must be in participants and authenticated
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;

      // Update: only participants can update
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      // Delete: only admins for groups, or participant for DM
      allow delete: if isSignedIn() &&
        (resource.data.type == 'direct'
          ? request.auth.uid in resource.data.participants
          : request.auth.uid in resource.data.adminIds);

      // ── Messages sub-collection ─────────────────────────────────────
      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000;

        // Allow updating readBy field only
        allow update: if isChatParticipant(chatId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);

        allow delete: if false; // No message deletion for now
      }
    }
  }
}
